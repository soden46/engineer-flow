{
  "schema_version": "1.0",
  "description": "Provider-neutral coding agent adapter contract. No real agent binding yet.",
  "adapter_config": {
    "adapter_id": "mock-agent-v0",
    "agent_name": "mock-agent",
    "agent_version": "0.1.0",
    "provider": null,
    "model": null,
    "model_version_or_snapshot_if_available": null,
    "timeout_ms": 300000,
    "max_turns_or_equivalent": 50,
    "max_output_tokens_or_equivalent": 100000,
    "temperature_or_equivalent": 0.0,
    "tool_permissions": ["read_file", "write_file", "run_command", "list_directory"],
    "network_policy": {
      "provider_network_required": true,
      "repository_network_policy": "blocked",
      "repository_network_enforced": false
    },
    "working_directory_policy": "isolated_run_root",
    "environment_policy": "isolated",
    "telemetry_capabilities": ["agent_name", "agent_version", "provider", "model", "started_at", "ended_at", "agent_duration_ms", "exit_status", "timeout", "tool_calls", "retries", "input_tokens", "output_tokens", "total_tokens", "cost", "telemetry_source", "ef_mode", "ef_primary", "ef_support", "ef_specialist_count", "ef_security_review", "ef_external_selected", "ef_memory_used"]
  },
  "common_agent_config_fields": [
    "agent_name",
    "agent_version",
    "provider",
    "model",
    "model_version_or_snapshot_if_available",
    "timeout_ms",
    "max_turns_or_equivalent",
    "max_output_tokens_or_equivalent",
    "temperature_or_equivalent",
    "tool_permissions",
    "network_policy",
    "working_directory_policy",
    "environment_policy"
  ],
  "treatment_fields": [
    "engineer_flow_enabled",
    "engineer_flow_source_commit",
    "engineer_flow_tree_hash",
    "engineer_flow_memory_root"
  ],
  "baseline_treatment": {
    "engineer_flow_enabled": false,
    "engineer_flow_source_commit": null,
    "engineer_flow_tree_hash": null,
    "engineer_flow_memory_root": null
  },
  "engineer_flow_treatment": {
    "engineer_flow_enabled": true,
    "engineer_flow_source_commit": "73c7661ef6cdb4bdda043a58d5b4bcb4a90d50eb",
    "engineer_flow_tree_hash": null,
    "engineer_flow_memory_root": null
  },
  "timer_boundary": {
    "setup_duration_ms": "outside_agent_time",
    "agent_duration_ms": "from_process_spawn_to_exit",
    "evaluation_duration_ms": "after_agent_exit"
  },
  "failure_classification": {
    "SETUP_INFRA_FAILURE": "retained_not_scored",
    "AGENT_TIMEOUT": "scored_failed",
    "AGENT_CRASH": "scored_failed",
    "AGENT_COMPLETED": "evaluator_determines_acceptance",
    "EVALUATOR_FAILURE": "not_scored_as_agent_correctness"
  },
  "telemetry_null_policy": {
    "rule": "unavailable_metrics_must_be_null_not_zero_or_estimated",
    "applies_to": ["input_tokens", "output_tokens", "total_tokens", "cost", "tool_calls", "retries"]
  },
  "secret_handling": {
    "rule": "provider_api_secrets_never_in_results_transcript_artifacts_config_hashes_logs"
  }
}
